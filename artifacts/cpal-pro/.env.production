# Production build overrides (loaded when Vite builds in production mode, i.e.
# `npm run build` / `npm run build:ghpages`). Takes precedence over .env.
#
# Production = accumax.ai, served by the `multi-tenant-server` backend.
# `nurturenext` is a STAGING-only tenant (accumax.io); it does NOT exist on prod.
# Production uses the `hyd` tenant (chatbot "HYDra", customer website
# www.nurturenext.com) on multi-tenant-server — widget-config returns 200.
#
# NOTE: tenant `hyd` has no chatbot logo uploaded (chatbotLogo is empty), so
# the widget shows the default icon + name "HYDra".
VITE_WIDGET_TENANT=hyd
VITE_WIDGET_API=https://multi-tenant-server.azurewebsites.net/api/v1
# FrontDesk widget bundle, served by react-client-portal at /widget.
VITE_WIDGET_SRC=https://client-portal-multi-tenant.azurewebsites.net/widget/askcpal-widget.js
